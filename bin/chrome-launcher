#!/bin/bash
# Chrome Launcher: pick a Chrome or Chromium profile with the arrow keys, then open
# a NEW window for it on the current workspace, even if that profile already has
# a window elsewhere. Uses the default browser; pass "chrome" or "chromium" to
# force one. With a single profile it opens that one without asking.

set -euo pipefail

browser=${1:-}
if [[ -z $browser ]]; then
  case $(xdg-settings get default-web-browser 2>/dev/null) in
    chromium.desktop) browser=chromium ;;
    google-chrome*.desktop) browser=chrome ;;
    *) command -v google-chrome-stable >/dev/null && browser=chrome || browser=chromium ;;
  esac
fi

# config dir, command, window class (also the icon name)
case $browser in
  chrome) config=google-chrome command=google-chrome-stable class=google-chrome ;;
  chromium) config=chromium command=chromium class=chromium ;;
  *) echo "chrome-launcher: unknown browser '$browser' (use chrome or chromium)" >&2; exit 1 ;;
esac

local_state="$HOME/.config/$config/Local State"
if [[ ! -r $local_state ]]; then
  notify-send "Chrome Launcher" "No profiles yet: start $command once so it creates its profile list."
  exit 1
fi

icon=""
for size in 256x256 128x128 64x64 48x48; do
  [[ -f /usr/share/icons/hicolor/$size/apps/$class.png ]] && icon=/usr/share/icons/hicolor/$size/apps/$class.png && break
done

# Everything exchanged with the picker lives in a private directory (mktemp -d
# creates it 0700): the profile list goes in as payload.json, the answer comes
# back as selection and done. Nothing but the directory's path is ever put on a
# command line, so no other user can read the profiles or plant files in its place.
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
selection_file=$tmpdir/selection
done_file=$tmpdir/done

# Profiles as a cross (plugin jimmibram.chrome-launcher), in the browser's own order:
# first is left, second right, third up, fourth down.
python3 - "$local_state" "$icon" <<'PY2' >"$tmpdir/payload.json"
import json, os, sys
state, icon = sys.argv[1:3]
root = os.path.dirname(state)
p = json.load(open(state)).get("profile", {})
profiles = []
cache = p.get("info_cache", {})
order = [d for d in p.get("profiles_order", []) if d in cache] + [d for d in cache if d not in p.get("profiles_order", [])]
for d in order:
    v = cache[d]
    pic = os.path.join(root, d, v.get("gaia_picture_file_name") or "")
    profiles.append({
        "dir": d,
        "name": v.get("name") or d,
        "email": v.get("user_name") or "",
        "picture": pic if os.path.isfile(pic) else "",
    })
print(json.dumps({"profiles": profiles, "icon": icon}))
PY2

count=$(jq '.profiles | length' "$tmpdir/payload.json")
if (( count == 0 )); then
  notify-send "Chrome Launcher" "No profiles found in $local_state"
  exit 1
elif (( count == 1 )); then
  # Only one profile: nothing to choose, open it straight away.
  dir=$(jq -r '.profiles[0].dir' "$tmpdir/payload.json")
else
  # Watch the directory for the picker's answer before summoning it, so the answer
  # can't arrive between the two. inotifywait says when its watch is in place.
  coproc PICK { inotifywait -m -e create -e moved_to --format %f "$tmpdir" 2>&1; }
  while IFS= read -r line <&"${PICK[0]}"; do
    [[ $line == "Watches established." ]] && break
  done

  if [[ $(omarchy-shell shell summon jimmibram.chrome-launcher "$(jq -cn --arg dir "$tmpdir" '{dir: $dir}')" 2>/dev/null) != ok ]]; then
    notify-send "Chrome Launcher" "The plugin isn't enabled. Run: omarchy plugin enable jimmibram.chrome-launcher"
    exit 1
  fi

  # The picker writes selection, then creates done. Whenever nothing has happened
  # for a couple of seconds, check that the shell is still there: if it went away
  # with the picker open, no answer is coming.
  until [[ -e $done_file ]]; do
    IFS= read -r -t 2 line <&"${PICK[0]}" && continue
    status=$?
    (( status > 128 )) || exit 1  # the watcher itself ended
    omarchy-shell shell ping >/dev/null 2>&1 || exit 1
  done
  kill "$PICK_PID" 2>/dev/null || true

  dir=""
  [[ -e $selection_file ]] && dir=$(<"$selection_file")
fi
[[ -n $dir ]] || exit 0

# The browser hands the request to its running process, which would open the window
# on the workspace of that profile's existing window. A temporary window rule
# makes it open on our workspace, then it's turned off again once the window has
# appeared (or after 10 seconds).
workspace=$(hyprctl activeworkspace -j | jq -r '.name')
events="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

# Quote a value as a Lua string literal. The workspace name comes from the user's
# config, so it must never be spliced into the eval'd program as code.
lua_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\'/\\\'}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  printf "'%s'" "$s"
}

# The rule's handle is kept in a Lua global named after this process, so two
# launches running at once each turn off their own rule and not each other's.
# Hyprland's Lua API can only disable a rule, not remove it, hence set_enabled.
rule_var=chrome_launcher_rule_$$
rule_on() {
  hyprctl eval "$rule_var = hl.window_rule({ match = { class = '^$class\$' }, workspace = $(lua_string "$workspace") })" >/dev/null
}
rule_off() {
  hyprctl eval "if $rule_var then $rule_var:set_enabled(false) end; $rule_var = nil" >/dev/null
}

coproc WATCH { timeout 10 socat -u "UNIX-CONNECT:$events" - 2>/dev/null; }
trap 'rule_off; kill "$WATCH_PID" 2>/dev/null || true; rm -rf "$tmpdir"' EXIT
rule_on
sleep 0.1  # let the watcher connect first
# Start the browser directly: omarchy-launch-browser takes its first argument for a
# URL and then focuses an existing Chrome window, which jumps workspaces.
setsid -f uwsm-app -- "$command" --profile-directory="$dir" --new-window >/dev/null 2>&1

# Done once a window of this browser appears on our workspace. (The browser's
# running process opens it, so there is no PID of our own to recognise it by.)
while IFS= read -r line <&"${WATCH[0]}"; do
  [[ $line == openwindow\>\>*,"$workspace","$class",* ]] && break
done
